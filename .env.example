# Скопируйте в `.env` и заполните токены. Файл `.env` в git не коммитить.

# Bearer для API (все маршруты кроме /health и /metrics). Пустой = никто не пройдёт.
API_TOKEN=
# Hugging Face: PyAnnote, VAD для GigaAM longform, чекпоинт NeMo Sortformer.
HF_TOKEN=

HOST=127.0.0.1
PORT=8000

DATA_DIR=./data
MODELS_DIR=./data/models
SQLITE_PATH=./data/tasks.db
LOG_DIR=./data/logs
PERFORMANCE_LOG=./data/logs/performance_log.csv
# Прикладной лог-файл + app-logger. false / 0 / no — выкл.
LOG_ENABLED=true
# CSV метрик + JSON metric_event в stdout. false / 0 / no — выкл.
PERFORMANCE_LOG_ENABLED=true
# Prometheus /metrics. false / 0 / no — прикладные метрики выкл., endpoint остаётся.
METRICS_ENABLED=true

# Чекпоинты (какие файлы весов). Не путать с PRELOAD_* — те решают, грузить ли семейство.
WHISPER_MODEL=large-v3-turbo
GIGAAM_MODEL=multilingual_large_ctc
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
NEMO_MODEL=nvidia/diar_streaming_sortformer_4spk-v2

# Какие семейства поднимать и скачивать при старте.
# whisper | gigaam | all
PRELOAD_ASR=all
# nemo | pyannote | all
PRELOAD_DIARIZATION=all

# Устройство инференса: auto | cpu | cuda.
# auto — CUDA если torch.cuda.is_available(), иначе CPU.
# cpu — всегда CPU (даже если есть GPU).
# cuda — только GPU; если CUDA нет, процесс не стартует.
DEVICE=auto

# Слоты задач в одном процессе uvicorn (не --workers).
WORKERS=1
# Максимум задач в queued. Сверх лимита — 503 queue_full.
WORKER_QUEUE_SIZE=4
# Максимум тела POST /transcribe в байтах (Content-Length и стрим файла). По умолчанию 1 GiB.
MAX_UPLOAD_BYTES=1073741824
# Секунд после success/error до удаления строки из SQLite. 0 — не удалять по TTL.
TASK_TTL_SEC=3600
# Таймаут ffmpeg на конвертацию MP3/M4A → WAV. 0 — без лимита.
FFMPEG_TIMEOUT_SEC=120
# Сколько раз вернуть running в queued после смерти процесса (OOM-kill, segfault).
# По умолчанию 1 — одна повторная попытка, дальше error process_killed. 0 — сразу ошибка.
# CUDA OOM — обычное Python-исключение, сюда не входит.
TASK_MAX_RESTARTS=1
